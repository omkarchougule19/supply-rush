# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to a local SQLite file if unset. Set to a postgres:// URL in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. "*" is fine for local dev only.
# ALLOWED_ORIGINS=https://your-deployed-domain.com

# ── Instructor login (HTTP Basic Auth — /instructor page + all instructor API) ─
# Comma-separated, order-matched lists — allows a small team of instructors.
# Leave BOTH commented out to use a real random password the app generates
# and persists itself (logged once on first use) — safer than a known
# placeholder value left in by mistake after `cp .env.example .env`.
# INSTRUCTOR_USERNAMES=admin
# INSTRUCTOR_PASSWORDS=set-a-real-password-here

# ── Student email verification (passwordless, one-time 6-digit codes) ─────────
# Off by default so local dev never needs Resend configured. Set to "true" to
# require every student to verify a school email before playing.
REQUIRE_STUDENT_VERIFICATION=false

# Only emails ending in this domain are accepted. Leave blank to allow any domain.
ALLOWED_STUDENT_EMAIL_DOMAIN=illinois.edu

# Signs the student session cookie. Leave commented out to use a real random
# secret the app generates and persists itself — set this explicitly only if
# you need sessions to survive swapping out the database (e.g. `openssl rand
# -hex 32`). Never set it to a fixed, source-visible value in production.
# SESSION_SECRET=

# Set to "false" only if serving over plain HTTP locally without TLS.
COOKIE_SECURE=true

# One of these two sends the verification codes. Required whenever
# REQUIRE_STUDENT_VERIFICATION=true — without either, codes are only logged
# to the server console (useful for local testing of the verification flow
# without sending real email). If both are set, SENDGRID_API_KEY wins.
#
# SendGrid (https://sendgrid.com) — verify a single sender address (just
# click a confirmation link, no DNS/domain ownership needed) and it can email
# any real recipient. Good enough to actually test with a real student inbox
# without owning a domain.
SENDGRID_API_KEY=
#
# Resend (https://resend.com) — simpler API, but sandbox mode can only email
# the address your Resend account itself is registered under until you
# verify a domain you own on resend.com/domains. Needed for real production
# volume; not convenient for a quick real-inbox test.
RESEND_API_KEY=
#
# Must be an address SendGrid/Resend actually lets you send from: the single
# sender you verified with SendGrid, or the default Resend sandbox sender.
EMAIL_FROM=Supply Rush <onboarding@resend.dev>

# Max verified students who can join a single shared group play.
MAX_GROUP_SIZE=60

# ── Misc ─────────────────────────────────────────────────────────────────────
# HIDE_DOCS=true
